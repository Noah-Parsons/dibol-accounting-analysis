@ECHO OFF
REM Synergy/DE v12 equivalent of ACCSET.BAT, rooted at this checkout
REM instead of C:\ACC. DBLDIR is left alone: under Synergy it names the
REM Synergy install, not the application's DBL directory.

FOR %%I IN ("%~dp0..") DO SET ACCROOT=%%~fI
CALL "%SYNERGYDE64%dbl\dblvars64.bat" >NUL

SET FD=%ACCROOT%\SRC\FD\
SET DBL=%ACCROOT%\DBL\
SET AP=%ACCROOT%\EXC\AP\
SET APX=%ACCROOT%\EXC\AP\
SET AR=%ACCROOT%\EXC\AR\
SET ARX=%ACCROOT%\EXC\AR\
SET BR=%ACCROOT%\EXC\BR\
SET BRX=%ACCROOT%\EXC\BR\
SET GL=%ACCROOT%\EXC\GL\
SET GLX=%ACCROOT%\EXC\GL\
SET PAY=%ACCROOT%\EXC\PR\
SET PAYX=%ACCROOT%\EXC\PR\
SET SEC=%ACCROOT%\EXC\SC\
SET SY=%ACCROOT%\EXC\SY\
SET SYS=%ACCROOT%\EXC\SY\
SET BCK=%ACCROOT%\BCK\
SET DAT=%ACCROOT%\DAT\
SET SPL=%ACCROOT%\SPL\
SET FRM=%ACCROOT%\FRM\
SET D01=%ACCROOT%\DAT\001\
SET D02=%ACCROOT%\DAT\002\
SET D03=%ACCROOT%\DAT\003\
SET D04=%ACCROOT%\DAT\004\
SET D05=%ACCROOT%\DAT\005\
SET TERM=ANSI
